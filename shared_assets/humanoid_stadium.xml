<mujoco model="stadium_3d_humanoid">
  <compiler angle="radian" coordinate="local"/>
  <option gravity="0 0 -9.81" timestep="0.005"/>
  <size nconmax="500" njmax="1000"/>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
    <texture name="texplane" type="2d" builtin="checker" rgb1="0.2 0.3 0.4" rgb2="0.1 0.15 0.2" width="512" height="512"/>
    <material name="matplane" reflectance="0.3" texture="texplane" texrepeat="1 1" texuniform="true"/>
    <material name="infield_dirt_mat" rgba="0.6 0.4 0.2 1" reflectance="0.1"/>
    <material name="home_plate_mat" rgba="0.9 0.9 0.9 1" reflectance="0.2"/>
    <material name="ball_mat" rgba="0.98 0.98 0.95 1" reflectance="0.4"/>
    <material name="bat_mat" rgba="0.8 0.6 0.3 1" reflectance="0.3"/>
    <material name="human_mat" rgba="0.8 0.6 0.5 1"/>
  </asset>

  <default>
    <!-- Basic defaults for joints and geoms -->
    <joint limited="true" damping="0.5" armature="0.1"/>
    <geom friction="0.8 0.1 0.1" margin="0.001" condim="3"/>
    
    <!-- Humanoid geom defaults -->
    <default class="humanoid">
      <geom type="capsule" material="human_mat"/>
    </default>
  </default>

  <worldbody>
    <light directional="true" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2" pos="0 0 10" dir="0 0 -1"/>
    
    <!-- Ground and field markings -->
    <geom name="ground" type="plane" size="30 30 0.1" material="matplane"/>
    <geom name="home_plate" type="box" size="0.22 0.22 0.005" pos="0 0 0.005" material="home_plate_mat"/>
    <geom name="pitcher_mound" type="box" size="0.3 0.1 0.005" pos="0 18.44 0.005" material="home_plate_mat"/>
    
    <!-- Cameras -->
    <camera name="pitcher_cam" pos="0 20.0 2.0" xyaxes="-1 0 0 0 0 1" fovy="60"/>
    <camera name="catcher_cam" pos="0 -2.0 1.2" xyaxes="1 0 0 0 0 1" fovy="60"/>
    <camera name="top_down_cam" pos="0 9.0 25.0" euler="0 0 0" fovy="70"/>
    
    <!-- Baseball -->
    <body name="baseball" pos="0 15 1.5">
      <freejoint name="ball_joint"/>
      <geom name="ball_geom" type="sphere" size="0.037" mass="0.145" material="ball_mat"/>
    </body>

    <!-- Full-body Humanoid Batter -->
    <!-- Positioned on the right side of home plate for a RHB -->
    <body name="pelvis" pos="-0.85 0 1.0">
      <!-- 6-DOF Root to allow striding and hip rotation without falling over (for kinematic control) -->
      <joint name="root_x" type="slide" axis="1 0 0" limited="false"/>
      <joint name="root_y" type="slide" axis="0 1 0" limited="false"/>
      <joint name="root_z" type="slide" axis="0 0 1" limited="false"/>
      <joint name="root_rx" type="hinge" axis="1 0 0" limited="false"/>
      <joint name="root_ry" type="hinge" axis="0 1 0" limited="false"/>
      <joint name="root_rz" type="hinge" axis="0 0 1" limited="false"/>
      
      <geom name="pelvis_geom" class="humanoid" size="0.1 0.15" pos="0 0 0" euler="1.57 0 0"/>
      
      <!-- Right Leg -->
      <body name="r_thigh" pos="0 -0.15 -0.1">
        <joint name="r_hip_x" type="hinge" axis="1 0 0" range="-1.5 1.5"/>
        <joint name="r_hip_y" type="hinge" axis="0 1 0" range="-1.5 1.5"/>
        <joint name="r_hip_z" type="hinge" axis="0 0 1" range="-1.5 1.5"/>
        <geom name="r_thigh_geom" class="humanoid" size="0.08 0.20" pos="0 0 -0.20"/>
        <body name="r_shin" pos="0 0 -0.40">
          <joint name="r_knee" type="hinge" axis="0 1 0" range="-2.5 0"/>
          <geom name="r_shin_geom" class="humanoid" size="0.07 0.18" pos="0 0 -0.18"/>
          <body name="r_foot" pos="0 0 -0.36">
            <joint name="r_ankle_x" type="hinge" axis="1 0 0" range="-0.5 0.5"/>
            <joint name="r_ankle_y" type="hinge" axis="0 1 0" range="-0.5 0.5"/>
            <geom name="r_foot_geom" type="box" size="0.12 0.06 0.02" pos="0.06 0 -0.02" material="human_mat"/>
          </body>
        </body>
      </body>
      
      <!-- Left Leg -->
      <body name="l_thigh" pos="0 0.15 -0.1">
        <joint name="l_hip_x" type="hinge" axis="1 0 0" range="-1.5 1.5"/>
        <joint name="l_hip_y" type="hinge" axis="0 1 0" range="-1.5 1.5"/>
        <joint name="l_hip_z" type="hinge" axis="0 0 1" range="-1.5 1.5"/>
        <geom name="l_thigh_geom" class="humanoid" size="0.08 0.20" pos="0 0 -0.20"/>
        <body name="l_shin" pos="0 0 -0.40">
          <joint name="l_knee" type="hinge" axis="0 1 0" range="-2.5 0"/>
          <geom name="l_shin_geom" class="humanoid" size="0.07 0.18" pos="0 0 -0.18"/>
          <body name="l_foot" pos="0 0 -0.36">
            <joint name="l_ankle_x" type="hinge" axis="1 0 0" range="-0.5 0.5"/>
            <joint name="l_ankle_y" type="hinge" axis="0 1 0" range="-0.5 0.5"/>
            <geom name="l_foot_geom" type="box" size="0.12 0.06 0.02" pos="0.06 0 -0.02" material="human_mat"/>
          </body>
        </body>
      </body>

      
      <!-- Spine (Twist) -->
      <body name="torso" pos="0 0 0.2">
        <joint name="spine_twist" type="hinge" axis="0 0 1" range="-1.5 1.5"/>
        <geom name="torso_geom" class="humanoid" size="0.12 0.25" pos="0 0 0.2"/>
        
        <!-- Head -->
        <body name="head" pos="0 0 0.6">
          <joint name="neck_pitch" type="hinge" axis="1 0 0" range="-0.5 0.5"/>
          <geom name="head_geom" class="humanoid" type="sphere" size="0.12" pos="0 0 0"/>
          <camera name="batter_cam" pos="0 0 0" xyaxes="1 0 0 0 0 1" fovy="90"/>
        </body>
        
        <!-- Right Arm (Back arm for RHB) -->
        <body name="r_upper_arm" pos="-0.15 0 0.4">
          <joint name="r_shoulder_z" type="hinge" axis="0 0 1" range="-1.5 1.5"/>
          <joint name="r_shoulder_y" type="hinge" axis="0 1 0" range="-1.5 1.5"/>
          <joint name="r_shoulder_x" type="hinge" axis="1 0 0" range="-1.5 1.5"/>
          <geom name="r_ua_geom" class="humanoid" size="0.04 0.15" pos="0 0 -0.15"/>
          
          <body name="r_lower_arm" pos="0 0 -0.3">
            <joint name="r_elbow" type="hinge" axis="0 1 0" range="0 2.5"/>
            <geom name="r_la_geom" class="humanoid" size="0.03 0.15" pos="0 0 -0.15"/>
            
            <body name="r_hand" pos="0 0 -0.3">
              <joint name="r_wrist_x" type="hinge" axis="1 0 0" range="-0.5 0.5"/>
              <joint name="r_wrist_y" type="hinge" axis="0 1 0" range="-0.5 0.5"/>
              <geom name="r_hand_geom" type="sphere" size="0.04" material="human_mat"/>
              
              <!-- Bat attached to Right Hand -->
              <body name="bat" pos="0 0 -0.1">
                <!-- No joints relative to hand, fixed to hand -->
                <!-- The bat points downwards slightly in neutral pose -->
                <geom name="bat_barrel" type="cylinder" size="0.03 0.45" pos="0 0 -0.45" material="bat_mat" mass="0.9"/>
                <!-- Site for the left hand to grab onto -->
                <site name="bat_grip_left" pos="0 0 0.05" size="0.01"/>
              </body>
            </body>
          </body>
        </body>
        
        <!-- Left Arm (Front arm for RHB) -->
        <body name="l_upper_arm" pos="0.15 0 0.4">
          <joint name="l_shoulder_z" type="hinge" axis="0 0 1" range="-1.5 1.5"/>
          <joint name="l_shoulder_y" type="hinge" axis="0 1 0" range="-1.5 1.5"/>
          <joint name="l_shoulder_x" type="hinge" axis="1 0 0" range="-1.5 1.5"/>
          <geom name="l_ua_geom" class="humanoid" size="0.04 0.15" pos="0 0 -0.15"/>
          
          <body name="l_lower_arm" pos="0 0 -0.3">
            <joint name="l_elbow" type="hinge" axis="0 1 0" range="0 2.5"/>
            <geom name="l_la_geom" class="humanoid" size="0.03 0.15" pos="0 0 -0.15"/>
            
            <body name="l_hand" pos="0 0 -0.3">
              <!-- Site to connect to the bat -->
              <site name="l_hand_grip" pos="0 0 0" size="0.01"/>
              <geom name="l_hand_geom" type="sphere" size="0.04" material="human_mat"/>
            </body>
          </body>
        </body>
        
      </body>
    </body>
  </worldbody>
  
  <equality>
    <!-- Connect left hand to the bat to form a closed kinematic chain (2-handed grip) -->
    <!-- The constraint brings l_hand_grip to bat_grip_left -->
    <connect name="left_hand_to_bat" site1="l_hand_grip" site2="bat_grip_left"/>
  </equality>
  
  <actuator>
    <!-- Add basic position actuators for kinematic control -->
    <position name="a_spine_twist" joint="spine_twist" kp="500"/>
    <position name="a_r_shoulder_z" joint="r_shoulder_z" kp="500"/>
    <position name="a_r_shoulder_y" joint="r_shoulder_y" kp="500"/>
    <position name="a_r_shoulder_x" joint="r_shoulder_x" kp="500"/>
    <position name="a_r_elbow" joint="r_elbow" kp="500"/>
    <position name="a_r_wrist_x" joint="r_wrist_x" kp="500"/>
    <position name="a_r_wrist_y" joint="r_wrist_y" kp="500"/>
    
    <!-- Left arm actuators REMOVED so the equality constraint can naturally pull the arm to the bat -->

    
    <!-- Leg actuators -->
    <position name="a_root_x" joint="root_x" kp="1000"/>
    <position name="a_root_y" joint="root_y" kp="1000"/>
    <position name="a_root_z" joint="root_z" kp="1000"/>
    <position name="a_root_rx" joint="root_rx" kp="1000"/>
    <position name="a_root_ry" joint="root_ry" kp="1000"/>
    <position name="a_root_rz" joint="root_rz" kp="1000"/>
    
    <position name="a_r_hip_x" joint="r_hip_x" kp="500"/>
    <position name="a_r_hip_y" joint="r_hip_y" kp="500"/>
    <position name="a_r_hip_z" joint="r_hip_z" kp="500"/>
    <position name="a_r_knee" joint="r_knee" kp="500"/>
    <position name="a_l_hip_x" joint="l_hip_x" kp="500"/>
    <position name="a_l_hip_y" joint="l_hip_y" kp="500"/>
    <position name="a_l_hip_z" joint="l_hip_z" kp="500"/>
    <position name="a_l_knee" joint="l_knee" kp="500"/>
  </actuator>
  
</mujoco>
