<mujoco model="stadium_3d_baseball_pro">
  <compiler angle="degree" coordinate="local" inertiafromgeom="true"/>

  <option gravity="0 0 -9.81" timestep="0.002" integrator="RK4">
    <flag constraint="enable" energy="enable"/>
  </option>

  <default>
    <joint limited="false" damping="0.01"/>
    <geom condim="3" friction="0.5 0.1 0.1" solref="0.004 1" solimp="0.9 0.95 0.001" margin="0.001"/>
  </default>

  <asset>
    <!-- Sky & Textures -->
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.3 0.55 0.9" rgb2="0.05 0.12 0.3" width="512" height="512"/>
    <texture name="grass_tex" type="2d" builtin="checker" rgb1="0.12 0.44 0.12" rgb2="0.09 0.36 0.09" width="256" height="256"/>
    <texture name="dirt_tex" type="2d" builtin="flat" rgb1="0.62 0.38 0.22" width="128" height="128"/>
    <texture name="wood_tex" type="2d" builtin="flat" rgb1="0.82 0.62 0.32" width="128" height="128"/>

    <!-- Materials -->
    <material name="grass" texture="grass_tex" texrepeat="35 35" reflectance="0.05"/>
    <material name="infield_dirt_mat" texture="dirt_tex" reflectance="0.05"/>
    <material name="warning_track_mat" rgba="0.68 0.42 0.25 1" reflectance="0.05"/>
    <material name="wood" texture="wood_tex" reflectance="0.3"/>
    <material name="ball_mat" rgba="0.98 0.98 0.95 1" reflectance="0.4"/>
    <material name="plate_mat" rgba="0.95 0.95 0.95 1"/>
    <material name="foul_line_mat" rgba="1 1 1 0.9"/>
    <material name="foul_pole_mat" rgba="0.95 0.85 0.1 1"/>
    <material name="strike_zone_mat" rgba="1 0.15 0.15 0.22"/>

    <!-- Stadium Materials -->
    <material name="fence_mat" rgba="0.1 0.25 0.14 1"/>
    <material name="batters_eye_mat" rgba="0.05 0.12 0.08 1"/> <!-- Dark Matte Centerfield Batter's Eye -->
    <material name="backstop_mat" rgba="0.15 0.15 0.18 1"/>

    <!-- Outfield Sponsor Ad Billboards -->
    <material name="ad_board_samsung" rgba="0.02 0.22 0.65 1"/> <!-- Blue Samsung Ad -->
    <material name="ad_board_lg" rgba="0.65 0.08 0.2 1"/>      <!-- Red LG Ad -->
    <material name="ad_board_hyundai" rgba="0.05 0.15 0.4 1"/>  <!-- Navy Hyundai Ad -->
    <material name="ad_board_kakao" rgba="0.95 0.82 0.05 1"/>   <!-- Yellow Kakao Ad -->
    <material name="scoreboard_mat" rgba="0.08 0.1 0.14 1"/>   <!-- Giant Centerfield Scoreboard -->
    <material name="scoreboard_screen" rgba="0.15 0.85 0.35 1"/>

    <!-- Seating Bleachers & Entry Tunnels -->
    <material name="seats_blue" rgba="0.15 0.35 0.65 1"/>
    <material name="seats_navy" rgba="0.08 0.18 0.38 1"/>
    <material name="seats_red" rgba="0.75 0.18 0.18 1"/>
    <material name="concrete_concourse" rgba="0.45 0.48 0.52 1"/>
    <material name="entry_tunnel" rgba="0.08 0.08 0.1 1"/>     <!-- Dark Portal Interior -->
    <material name="dugout_roof" rgba="0.2 0.22 0.25 1"/>
  </asset>

  <worldbody>
    <!-- Lighting: Realistic Stadium Floodlights -->
    <light name="light_main" pos="0 25 35" dir="0 -0.5 -1" directional="true" diffuse="0.9 0.9 0.95" specular="0.3 0.3 0.3"/>
    <light name="light_left" pos="-35 50 30" dir="0.5 -0.5 -1" directional="true" diffuse="0.6 0.6 0.65"/>
    <light name="light_right" pos="35 50 30" dir="-0.5 -0.5 -1" directional="true" diffuse="0.6 0.6 0.65"/>

    <!-- Outfield Grass Surface -->
    <geom name="outfield_grass" type="plane" size="130 130 0.1" pos="0 35 0" material="grass"/>

    <!-- Infield Pitcher's Mound & Plate -->
    <geom name="pitcher_mound" type="cylinder" size="2.74 0.25" pos="0 18.44 0" material="infield_dirt_mat"/>
    <geom name="pitcher_rubber" type="box" size="0.30 0.07 0.02" pos="0 18.44 0.26" material="plate_mat"/>

    <!-- Infield Diamond Base Paths -->
    <geom name="path_home_1st" type="box" size="0.9 9.7 0.003" pos="9.7 9.7 0.003" euler="0 0 -45" material="infield_dirt_mat"/>
    <geom name="path_home_3rd" type="box" size="0.9 9.7 0.003" pos="-9.7 9.7 0.003" euler="0 0 45" material="infield_dirt_mat"/>
    <geom name="path_1st_2nd" type="box" size="0.9 9.7 0.003" pos="9.7 27.7 0.003" euler="0 0 45" material="infield_dirt_mat"/>
    <geom name="path_3rd_2nd" type="box" size="0.9 9.7 0.003" pos="-9.7 27.7 0.003" euler="0 0 -45" material="infield_dirt_mat"/>
    <geom name="infield_skin_dirt" type="cylinder" size="19.0 0.004" pos="0 18.44 0.004" material="infield_dirt_mat"/>

    <!-- Home Plate & Batter's Boxes -->
    <geom name="home_plate" type="box" size="0.216 0.216 0.01" pos="0 0 0.005" material="plate_mat"/>
    <geom name="left_batter_box" type="box" size="0.6 1.2 0.002" pos="-0.85 0.25 0.002" material="infield_dirt_mat"/>
    <geom name="right_batter_box" type="box" size="0.6 1.2 0.002" pos="0.85 0.25 0.002" material="infield_dirt_mat"/>
    
    <!-- Tee-Ball Stand -->
    <geom name="tee_stand_base" type="cylinder" size="0.1 0.02" pos="0 0 0.02" material="wood" contype="0" conaffinity="0"/>
    <geom name="tee_stand_pole" type="cylinder" size="0.02 0.48" pos="0 0 0.5" material="wood" contype="0" conaffinity="0"/>

    <!-- 3D Strike Zone Volume Visualization (Sensor Region) -->
    <geom name="strike_zone_box" type="box" size="0.216 0.01 0.30" pos="0 0 0.75" material="strike_zone_mat" contype="0" conaffinity="0"/>

    <!-- Bases (1st, 2nd, 3rd Base Bags) -->
    <geom name="base_1st" type="box" size="0.19 0.19 0.04" pos="13.72 13.72 0.04" euler="0 0 45" material="plate_mat"/>
    <geom name="base_2nd" type="box" size="0.19 0.19 0.04" pos="0 27.43 0.04" euler="0 0 45" material="plate_mat"/>
    <geom name="base_3rd" type="box" size="0.19 0.19 0.04" pos="-13.72 13.72 0.04" euler="0 0 45" material="plate_mat"/>

    <!-- 1st Base & 3rd Base Dugouts -->
    <geom name="dugout_1st_roof" type="box" size="1.2 8.0 0.6" pos="16.5 6.0 0.6" material="dugout_roof"/>
    <geom name="dugout_3rd_roof" type="box" size="1.2 8.0 0.6" pos="-16.5 6.0 0.6" material="dugout_roof"/>

    <!-- Outfield Warning Track & Curved Wall Fences -->
    <geom name="warning_track" type="box" size="70 3.5 0.004" pos="0 72 0.004" material="warning_track_mat"/>
    <geom name="fence_left_wall" type="box" size="26 0.4 2.2" pos="-45 60 2.2" euler="0 0 25" material="fence_mat"/>
    <geom name="fence_center_wall" type="box" size="22 0.4 2.5" pos="0 75 2.5" material="fence_mat"/>
    <geom name="fence_right_wall" type="box" size="26 0.4 2.2" pos="45 60 2.2" euler="0 0 -25" material="fence_mat"/>

    <!-- Outfield Sponsor Ad Billboards Mounted on Wall -->
    <geom name="ad_samsung" type="box" size="6.0 0.05 1.0" pos="-35 55.2 2.2" euler="0 0 25" material="ad_board_samsung"/>
    <geom name="ad_lg" type="box" size="6.0 0.05 1.0" pos="-20 62.2 2.2" euler="0 0 25" material="ad_board_lg"/>
    <geom name="ad_hyundai" type="box" size="6.0 0.05 1.2" pos="0 74.5 2.5" material="ad_board_hyundai"/>
    <geom name="ad_kakao" type="box" size="6.0 0.05 1.0" pos="20 62.2 2.2" euler="0 0 -25" material="ad_board_kakao"/>
    <geom name="ad_sponsor_right" type="box" size="6.0 0.05 1.0" pos="35 55.2 2.2" euler="0 0 -25" material="ad_board_samsung"/>

    <!-- Centerfield Giant Scoreboard & Batter's Eye -->
    <geom name="batters_eye" type="box" size="12 0.2 6.0" pos="0 77 6.0" material="batters_eye_mat"/>
    <geom name="jumbo_scoreboard" type="box" size="16 0.5 6.0" pos="0 79 14.0" material="scoreboard_mat"/>
    <geom name="scoreboard_display" type="box" size="14 0.05 4.5" pos="0 78.7 14.0" material="scoreboard_screen"/>

    <!-- Yellow Foul Poles (Left & Right Field) -->
    <geom name="foul_pole_left" type="cylinder" size="0.15 7.0" pos="-58 60 7.0" material="foul_pole_mat"/>
    <geom name="foul_pole_right" type="cylinder" size="0.15 7.0" pos="58 60 7.0" material="foul_pole_mat"/>

    <!-- Foul Lines -->
    <geom name="foul_line_left" type="box" size="0.06 43 0.003" pos="-21.5 21.5 0.003" euler="0 0 -45" material="foul_line_mat" contype="0" conaffinity="0"/>
    <geom name="foul_line_right" type="box" size="0.06 43 0.003" pos="21.5 21.5 0.003" euler="0 0 45" material="foul_line_mat" contype="0" conaffinity="0"/>

    <!-- Backstop Wall & Net Behind Home Plate -->
    <geom name="backstop_wall" type="box" size="12 0.5 2.5" pos="0 -4.0 2.5" material="backstop_mat"/>

    <!-- Multi-tiered Stadium Seating Stands & Concourse Entry Portals -->
    <!-- 1st Base Seating Bleachers -->
    <geom name="stand_1st_lower" type="box" size="10 30 3.0" pos="32 20 3.0" euler="-12 0 -25" material="seats_navy"/>
    <geom name="stand_1st_upper" type="box" size="12 35 6.0" pos="50 18 10.0" euler="-22 0 -25" material="seats_blue"/>
    <!-- Entry Portals / Tunnels on 1st Base Stand -->
    <geom name="portal_1st_1" type="box" size="1.8 1.5 2.2" pos="30 15 2.2" euler="0 0 -25" material="entry_tunnel"/>
    <geom name="portal_1st_2" type="box" size="1.8 1.5 2.2" pos="34 25 3.2" euler="0 0 -25" material="entry_tunnel"/>

    <!-- 3rd Base Seating Bleachers -->
    <geom name="stand_3rd_lower" type="box" size="10 30 3.0" pos="-32 20 3.0" euler="-12 0 25" material="seats_navy"/>
    <geom name="stand_3rd_upper" type="box" size="12 35 6.0" pos="-50 18 10.0" euler="-22 0 25" material="seats_red"/>
    <!-- Entry Portals / Tunnels on 3rd Base Stand -->
    <geom name="portal_3rd_1" type="box" size="1.8 1.5 2.2" pos="-30 15 2.2" euler="0 0 25" material="entry_tunnel"/>
    <geom name="portal_3rd_2" type="box" size="1.8 1.5 2.2" pos="-34 25 3.2" euler="0 0 25" material="entry_tunnel"/>

    <!-- Home Plate Grandstand & Press Box -->
    <geom name="stand_home_grand" type="box" size="18 8.0 5.0" pos="0 -12 6.0" euler="-25 0 0" material="seats_navy"/>
    <geom name="portal_home_center" type="box" size="2.5 1.5 2.5" pos="0 -10 3.5" material="entry_tunnel"/>

    <!-- ⚾ 투수 로봇 (8 DOF: 어깨3 + 팔꿈치2 + 손목2 + 릴리즈1) -->
    <body name="pitcher_base" pos="0 18.44 0.26">
      <geom type="box" size="0.4 0.3 0.25" mass="80.0" material="seats_navy"/>
      <body name="pitcher_shoulder" pos="0 0 1.2">
        <joint name="p_shoulder_pitch" type="hinge" axis="1 0 0" range="-30 210" damping="5.0" armature="0.5"/>
        <joint name="p_shoulder_yaw" type="hinge" axis="0 0 1" range="-45 45" damping="3.0" armature="0.3"/>
        <joint name="p_shoulder_roll" type="hinge" axis="0 1 0" range="-120 120" damping="3.0" armature="0.3"/>
        <geom name="p_shoulder_geom" type="sphere" size="0.1" material="plate_mat" mass="2.0"/>
        <geom name="p_upper_arm" type="capsule" size="0.07 0.225" pos="0 0 -0.225" material="plate_mat" mass="6.0"/>
        <body name="pitcher_elbow" pos="0 0 -0.45">
          <joint name="p_elbow_flex" type="hinge" axis="1 0 0" range="0 150" damping="3.0" armature="0.3"/>
          <joint name="p_elbow_pronate" type="hinge" axis="0 0 1" range="-90 90" damping="1.0" armature="0.1"/>
          <geom name="p_elbow_geom" type="sphere" size="0.08" material="plate_mat" mass="1.0"/>
          <geom name="p_forearm" type="capsule" size="0.06 0.2" pos="0 0 -0.2" material="plate_mat" mass="3.0"/>
          <body name="pitcher_wrist" pos="0 0 -0.4">
            <joint name="p_wrist_flex" type="hinge" axis="1 0 0" range="-70 70" damping="1.0" armature="0.1"/>
            <joint name="p_wrist_dev" type="hinge" axis="0 1 0" range="-30 30" damping="1.0" armature="0.1"/>
            <geom name="p_wrist_geom" type="sphere" size="0.06" material="plate_mat" mass="1.0"/>
            <!-- 볼은 별도 freejoint(baseball)이므로 투수 손 끝에는 릴리즈용 위치 마커만 둠 -->
            <site name="p_release_site" pos="0 0 -0.1" size="0.02" rgba="1 0 0 1"/>
          </body>
        </body>
      </body>
    </body>

    <!-- 🎥 멀티뷰 카메라들 -->
    <camera name="pitcher_cam" pos="0 20.0 2.0" xyaxes="-1 0 0 0 0 1" fovy="60"/>
    <camera name="catcher_cam" pos="0 -2.0 1.2" xyaxes="1 0 0 0 0 1" fovy="60"/>
    <camera name="broadcaster_cam" pos="0 -10.0 8.0" euler="65 0 0" fovy="50"/>
    <camera name="top_down_cam" pos="0 9.0 25.0" euler="0 0 0" fovy="70"/>

    <!-- Baseball Object (Free Joint, 3D Dynamic Sphere) -->
    <body name="baseball" pos="0 18.44 1.8">
      <freejoint name="ball_joint"/>
      <geom name="ball_geom" type="sphere" size="0.037" mass="0.145" material="ball_mat" condim="3" friction="0.3 0.05 0.05"/>
    </body>

    <!-- Realistic Batter Model: 9-DOF Robot (7-DOF Arm + 2-DOF Neck) -->
    <body name="batter_torso" pos="-0.85 -0.1 0">
      <geom name="torso_geom" type="capsule" size="0.15 0.3" pos="0 0 1.1" material="seats_navy" mass="20.0" contype="0" conaffinity="0"/>
      
      <!-- Neck & Head (2 DOF) -->
      <body name="neck" pos="0 0 1.6">
        <joint name="head_yaw" type="hinge" axis="0 0 1" range="-90 90" damping="0.5" armature="0.05"/>
        <joint name="head_pitch" type="hinge" axis="0 1 0" range="-45 45" damping="0.5" armature="0.05"/>
        <geom name="head_geom" type="sphere" size="0.1" material="plate_mat" mass="1.0" contype="0" conaffinity="0"/>
        <!-- 1인칭 카메라 (머리와 함께 회전) -->
        <camera name="batter_cam" pos="0 0 0" xyaxes="1 0 0 0 0 1" fovy="90"/>
      </body>
      
      <!-- Shoulder (3 DOF) -->
      <body name="shoulder" pos="0 -0.2 1.3">
        <joint name="shoulder_yaw" type="hinge" axis="0 0 1" range="-90 120" damping="2.0" armature="0.1"/>
        <joint name="shoulder_pitch" type="hinge" axis="1 0 0" range="-90 90" damping="2.0" armature="0.1"/>
        <joint name="shoulder_roll" type="hinge" axis="0 1 0" range="-90 90" damping="2.0" armature="0.1"/>
        <geom name="shoulder_geom" type="sphere" size="0.1" material="plate_mat" mass="3.0" contype="0" conaffinity="0"/>
        <geom name="upper_arm_geom" type="capsule" size="0.06" fromto="0 0 0  0 -0.1 -0.3" material="plate_mat" mass="3.0" contype="0" conaffinity="0"/>
        
        <!-- Elbow (1 DOF) -->
        <body name="elbow" pos="0 -0.1 -0.3">
          <joint name="elbow_flex" type="hinge" axis="0.53 -0.80 0.27" range="-150 150" damping="2.0" armature="0.1"/>
          <geom name="elbow_geom" type="sphere" size="0.08" material="plate_mat" mass="2.0" contype="0" conaffinity="0"/>
          <geom name="forearm_geom" type="capsule" size="0.05" fromto="0 0 0  0.3 0.3 0.3" material="plate_mat" mass="2.0" contype="0" conaffinity="0"/>
          
          <!-- Wrist (3 DOF) -->
          <body name="wrist" pos="0.3 0.3 0.3">
            <joint name="wrist_yaw" type="hinge" axis="0 0 1" range="-90 90" damping="1.0" armature="0.1"/>
            <joint name="wrist_pitch" type="hinge" axis="1 0 0" range="-90 90" damping="1.0" armature="0.1"/>
            <joint name="wrist_roll" type="hinge" axis="0 1 0" range="-90 90" damping="1.0" armature="0.1"/>
            <geom name="wrist_geom" type="sphere" size="0.06" material="plate_mat" mass="1.0" contype="0" conaffinity="0"/>
            
            <!-- Bat (Points UP and BACK in resting stance) -->
            <body name="bat" pos="0 0 0" euler="-45 0 0">
              <geom name="bat_knob" type="cylinder" size="0.025 0.015" pos="0 0 -0.015" material="wood" mass="0.05"/>
              <geom name="bat_handle" type="cylinder" size="0.014 0.2" pos="0 0 0.2" material="wood" mass="0.25"/>
              <geom name="bat_taper" type="capsule" size="0.024 0.1" pos="0 0 0.45" material="wood" mass="0.2"/>
              <geom name="bat_barrel" type="cylinder" size="0.034 0.25" pos="0 0 0.675" material="wood" mass="0.5" condim="3" friction="0.6 0.1 0.1"/>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- Mobile Center Fielder Robot -->
    <body name="fielder_cf" pos="0 60 0.5">
      <joint name="cf_slide_x" type="slide" axis="1 0 0" damping="50" armature="1.0"/>
      <joint name="cf_slide_y" type="slide" axis="0 1 0" damping="50" armature="1.0"/>
      
      <!-- Base Chassis -->
      <geom name="cf_base" type="cylinder" size="0.3 0.2" material="seats_blue" mass="30.0" contype="0" conaffinity="0"/>
      <body name="cf_head_body" pos="0 0 1.0">
        <geom name="cf_head" type="sphere" size="0.15" material="plate_mat" mass="5.0" contype="0" conaffinity="0"/>
        <!-- 1인칭 카메라 (중견수 시야) -->
        <camera name="fielder_cam" pos="0 0 0" xyaxes="-1 0 0 0 0 1" fovy="90"/>
      </body>
      
      <!-- Simple Catching Arm / Glove -->
      <body name="cf_arm" pos="0 -0.3 0.8">
        <joint name="cf_arm_pitch" type="hinge" axis="1 0 0" range="-45 45" damping="2.0" armature="0.1"/>
        <geom name="cf_glove" type="sphere" size="0.2" material="wood" mass="2.0" condim="3" friction="1.0 0.5 0.5"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- Batter Actuators -->
    <motor joint="shoulder_yaw" ctrlrange="-200 200" gear="2.0"/>
    <motor joint="shoulder_pitch" ctrlrange="-200 200" gear="2.0"/>
    <motor joint="shoulder_roll" ctrlrange="-200 200" gear="2.0"/>
    <motor joint="elbow_flex" ctrlrange="-150 150" gear="2.0"/>
    <motor joint="wrist_yaw" ctrlrange="-50 50" gear="1.0"/>
    <motor joint="wrist_pitch" ctrlrange="-50 50" gear="1.0"/>
    <motor joint="wrist_roll" ctrlrange="-50 50" gear="1.0"/>
    
    <!-- Pitcher Actuators -->
    <motor joint="p_shoulder_pitch" ctrlrange="-250 250" gear="2.5"/>
    <motor joint="p_shoulder_yaw" ctrlrange="-250 250" gear="2.5"/>
    <motor joint="p_shoulder_roll" ctrlrange="-250 250" gear="2.5"/>
    <motor joint="p_elbow_flex" ctrlrange="-150 150" gear="2.0"/>
    <motor joint="p_elbow_pronate" ctrlrange="-150 150" gear="2.0"/>
    <motor joint="p_wrist_flex" ctrlrange="-50 50" gear="1.0"/>
    <motor joint="p_wrist_dev" ctrlrange="-50 50" gear="1.0"/>
    
    <!-- Fielder Actuators -->
    <motor joint="cf_slide_x" ctrlrange="-200 200" gear="1.0"/>
    <motor joint="cf_slide_y" ctrlrange="-200 200" gear="1.0"/>
    <motor joint="cf_arm_pitch" ctrlrange="-50 50" gear="1.0"/>
    
    <!-- Neck Actuators -->
    <motor joint="head_yaw" ctrlrange="-50 50" gear="1.0"/>
    <motor joint="head_pitch" ctrlrange="-50 50" gear="1.0"/>
  </actuator>
</mujoco>
