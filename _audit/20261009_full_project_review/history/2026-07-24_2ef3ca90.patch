+    )
+    parser.add_argument(
+        '--at-bats', type=int, default=9,
+        help='실행할 타석 수 (기본 9)',
+    )
+    parser.add_argument(
+        '--delay', type=float, default=1.0,
+        help='AI 행동 간 딜레이 (초, 관전 모드)',
+    )
+
+    args = parser.parse_args()
+
+    game = BaseballGame(
+        role=args.role,
+        checkpoint_path=args.checkpoint,
+        delay=args.delay,
