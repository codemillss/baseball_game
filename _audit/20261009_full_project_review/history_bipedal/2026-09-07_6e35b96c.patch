+            f_pos,                                       # 3
+            f_vel,                                       # 3
+            f_quat,                                      # 4
+            f_angvel,                                    # 3
+            f_rel_ball,                                  # 3
+            np.array([f_dist_ball], dtype=np.float32),   # 1
+            f_rel_1b,                                    # 2
+            np.array([f_dist_1b], dtype=np.float32),     # 1
