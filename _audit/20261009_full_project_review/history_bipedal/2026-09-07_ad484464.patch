+            pelvis_pos,                                         # 3
+            pelvis_vel,                                         # 3
+            pelvis_quat,                                        # 4
+            pelvis_angvel,                                      # 3
+            rel_1b,                                             # 2
+            np.array([dist_1b, heading_err], dtype=np.float32), # 2
