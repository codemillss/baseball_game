+            goals,                                       # 3
+            swing_qpos,                                  # 5
+            swing_qvel,                                  # 5
+            sweet_pos,                                   # 3
+            sweet_vel,                                   # 3
+            pelvis_pos,                                  # 3
+            pelvis_vel,                                  # 3
