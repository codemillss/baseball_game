+        if self.render_mode == "rgb_array" and self.renderer is not None:
+            self.renderer.update_scene(self.data, camera=camera_name)
+            return self.renderer.render()
+        return None
+
+    def close(self):
+        if self.renderer is not None:
+            self.renderer.close()
